[model]
name = "qwen-plus"
temperature = 0.0
base_url = "https://dashscope.aliyuncs.com/compatible-mode/v1"
# 阿里云百炼 API Key。留空时改读环境变量 DASHSCOPE_API_KEY 或 OPENAI_API_KEY。
api_key = ""

[agent]
system_prompt = "你只能通过 sum_csv_column 读取 CSV 并合计。不要心算。"

[data]
csv = "data/sales.csv"
column = "amount"

[openai]
API_URL = ""
API_KEY = ""
